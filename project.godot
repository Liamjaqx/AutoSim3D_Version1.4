; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AutoSim3D "
config/version="1.3"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7")
config/icon="uid://d4m7iv3yju7ij"

[audio]

buses/default_bus_layout=""

[autoload]

DatabaseManager="*uid://fklf7r065aho"
Global="*uid://dmemhwwk3qqay"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/extend_to_title=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/bg_color=Color(0.14, 0.14, 0.14, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg")

[gui]

theme/custom="uid://dy3qkl7d4ewo7"
theme/custom_font="uid://cpnv4dsc6652n"
common/drop_mouse_on_gui_input_disabled=true

